{
  "$schema": "https://schema.tauri.app/config/2.0.0-rc",
  "productName": "TimeTrack Suite",
  "version": "0.1.0",
  "identifier": "com.timetracksuite.app",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @timetrack/web dev",
    "beforeBuildCommand": "pnpm --filter @timetrack/web build"
  },
  "app": {
    "windows": [
      {
        "title": "TimeTrack Suite",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
