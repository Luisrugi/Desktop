{
  "name": "TimeTrack Suite",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start.sh",
  "forwardPorts": [5173, 4000],
  "portsAttributes": {
    "5173": { "label": "Web-App", "onAutoForward": "openBrowser" },
    "4000": { "label": "API", "onAutoForward": "silent" }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    }
  }
}
